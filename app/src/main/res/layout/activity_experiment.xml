<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="0dp"
    tools:context="de.rwth_aachen.phyphox.Experiment"
    android:clickable="false"
    android:id="@+id/rootLayout">

        <androidx.appcompat.widget.Toolbar
            android:layout_alignParentTop="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/customActionBar"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.Phyphox.ActionBar">
            <!-- The status bar inset is applied as padding to the toolbar, and its minHeight
                 counts that padding, so the minimum is satisfied by the inset alone and the
                 content area collapses to whatever the children happen to need - less than the
                 standard action bar height, with the title and the icons ending up on different
                 lines. Requesting that height for the title restores the standard content area,
                 which lines the title up with the navigation button and the menu items.
                 wrap_content keeps it able to grow when a long title needs a second line. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/phyphox_white_90"
                style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
                android:id="@+id/titleText" />
        </androidx.appcompat.widget.Toolbar>

    <com.google.android.material.tabs.TabLayout
        android:elevation="4dp"
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/customActionBar"
        app:tabMode="scrollable"
    />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tab_layout"
        android:id="@+id/errorMessage"
        android:text=""
        android:paddingLeft="@dimen/activity_horizontal_padding"
        android:paddingRight="@dimen/activity_horizontal_padding"
        android:visibility="invisible"/>

    <androidx.viewpager.widget.ViewPager
        android:layout_below="@id/tab_layout"
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/recycler_view_battery"
        />

    <FrameLayout
        android:id="@+id/fl_remoteInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_above="@id/recycler_view_battery"
        android:theme="@style/Widget.Phyphox.DayNight"
        android:visibility="invisible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/remoteInfo"
            android:layout_gravity="top|start"
            android:textIsSelectable="true"
            android:paddingLeft="@dimen/activity_horizontal_padding"
            android:paddingRight="@dimen/activity_horizontal_padding"
            android:text="@string/remoteServerActive"
            />

        <ImageView
            android:id="@+id/iv_remoteInfo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:paddingEnd="12dp"
            android:paddingLeft="4dp"
            android:paddingBottom="4dp"
            android:layout_gravity="bottom|end"
            app:srcCompat="@drawable/ic_info"
            android:paddingRight="4dp" />

    </FrameLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:layout_constraintHeight_max="50dp"
        android:scrollbars="vertical">

    </androidx.recyclerview.widget.RecyclerView>


</RelativeLayout>
